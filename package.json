{
  "name": "nex-ai",
  "version": "1.0.0",
  "description": "NEX AI - Advanced AI-Powered Code Assistant",
  "main": "dist/main/main.js",
  "author": "NEX AI Team",
  "license": "MIT",
  "homepage": "https://nexai.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/nexai/nex-ai"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently --kill-others \"npm run dev:renderer\" \"node scripts/wait-for-vite.js\"",
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "npm run build:main && electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --config",
    "postinstall": "electron-builder install-app-deps",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fixture:setup": "node tests/fixtures/setup-fixture.js",
    "test:security": "npx tsx tests/security/test-phase1.ts && npx tsx tests/security/test-sanitize.ts",
    "test:persistence": "npx tsx tests/persistence/test-phase2.ts",
    "test:registry": "npx tsx tests/local-ai/test-registry.ts",
    "test:inference": "node tests/local-ai/test-inference-electron.js",
    "test:provider": "node tests/local-ai/test-provider.js",
    "test:infra": "node tests/local-ai/test-infra.js",
    "test:smoke": "node tests/local-ai/test-smoke.js",
    "test:agent:cancellation": "node tests/agent/test-h-cancellation.js && node tests/agent/test-h-cancel-with-model.js",
    "test:agent:e2e": "node tests/agent/test-g-e2e-coding.js",
    "test:agent:offline": "node tests/agent/test-i-offline.js",
    "test:agent:state": "node tests/agent/test-j-state-secrets.js",
    "test:agent:all": "npm run build:main && npm run test:agent:cancellation && npm run test:agent:e2e && npm run test:agent:offline && npm run test:agent:state"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "chokidar": "^3.6.0",
    "glob": "^10.3.10",
    "lucide-react": "^0.344.0",
    "node-llama-cpp": "^3.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.58",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.9.1",
    "jsdom": "^30.0.1",
    "linkedom": "^0.18.13",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.nexai.desktop",
    "productName": "NEX AI",
    "copyright": "Copyright © 2024 NEX AI Team",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.png",
          "icon.ico"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "NEX-AI-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NEX AI",
      "uninstallDisplayName": "NEX AI",
      "artifactName": "NEX-AI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NEX-AI-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "node-llama-cpp@3.20.0": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "electron@31.7.7": true
  }
}
